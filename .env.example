# --- PayPal (Orders v2, intent=AUTHORIZE) ---
# "sandbox" talks to api-m.sandbox.paypal.com, "mock" is an offline simulator.
# Default: sandbox if PAYPAL_CLIENT_ID is set, otherwise mock.
JANUS_PAYPAL=
# developer.paypal.com > Apps & Credentials > Sandbox > your app > Client ID / Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional sandbox negative testing, e.g. capture=INSTRUMENT_DECLINED or void=INTERNAL_SERVER_ERROR
JANUS_PAYPAL_NEGATIVE_TEST=

# --- AI (Claude with vision) ---
# "claude" calls the Claude API, "mock" uses an offline colour comparison.
# Default: claude if ANTHROPIC_API_KEY is set, otherwise mock.
JANUS_AI=
ANTHROPIC_API_KEY=
JANUS_MODEL=claude-opus-5-5
# Below this confidence Janus never moves money (HOLD).
JANUS_MIN_CONFIDENCE=0.85

# --- Security (secrets only ever come from the environment) ---
# Signs capability tokens and photo URLs. setup.sh fills this in; or: python -m janus secret
JANUS_SECRET=
# Provider API keys, one tenant each: "acme:<key>,beta:<key>" (keys at least 22 characters)
JANUS_TENANT_KEYS=
# Read-only operator access to every tenant (at least 22 characters)
JANUS_ADMIN_TOKEN=
# 1: anyone may create thresholds in the "public" tenant (rate limited). 0: tenant key required.
JANUS_PUBLIC_CREATE=1
# developer.paypal.com > your app > Webhooks > Webhook ID (needed to verify sandbox webhooks)
PAYPAL_WEBHOOK_ID=

# --- App ---
JANUS_DATA_DIR=./data
# The URL people open. For a phone, use a tunnel (e.g. https://xxxx.trycloudflare.com).
JANUS_BASE_URL=http://localhost:8000
# Scheduler interval inside `serve` (seconds); or run `python -m janus tick` from cron.
JANUS_TICK_SECONDS=300
# json: one JSON object per log line on stderr
JANUS_LOG_FORMAT=
