# --- PayPal (Orders v2, intent=AUTHORIZE) ---
# "sandbox" talks to api-m.sandbox.paypal.com, "mock" is an offline simulator.
# Default: sandbox if PAYPAL_CLIENT_ID is set, otherwise mock.
JANUS_PAYPAL=sandbox
# developer.paypal.com > Apps & Credentials > Sandbox > your app > Client ID / Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional sandbox negative testing, e.g. capture=INSTRUMENT_DECLINED or void=INTERNAL_SERVER_ERROR
JANUS_PAYPAL_NEGATIVE_TEST=

# --- AI (Claude with vision) ---
# "claude" calls the Claude API, "mock" uses an offline colour comparison.
# Default: claude if ANTHROPIC_API_KEY is set, otherwise mock.
JANUS_AI=claude
ANTHROPIC_API_KEY=
JANUS_MODEL=claude-opus-5-5
# Below this confidence Janus never moves money (HOLD).
JANUS_MIN_CONFIDENCE=0.85

# --- App ---
JANUS_DATA_DIR=./data
# The URL people open. For a phone, use a tunnel (e.g. https://xxxx.trycloudflare.com).
JANUS_BASE_URL=http://localhost:8000
