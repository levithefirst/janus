# Eid configuration. Copy to .env:  cp .env.example .env
# Every value is optional. With this file unchanged, Eid runs fully offline
# (mock PayPal + mock AI). Fill in a section to switch that integration to the real one.

# ---------------------------------------------------------------------------
# PayPal (Orders v2, sandbox only)
# Get these at https://developer.paypal.com > Apps & Credentials > Sandbox > your app.
# With both set, Eid uses https://api-m.sandbox.paypal.com. With either blank, the offline mock.
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Claude (the three AI steps: job card, gap report, acceptance packet)
# Get a key at https://console.anthropic.com. With it set, Eid calls Claude; blank = offline mock.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model used for all three AI steps.
EID_MODEL=claude-opus-5-5

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
# Force a mode instead of choosing from the keys above: sandbox|mock and claude|mock.
# Example: EID_PAYPAL=mock with a real ANTHROPIC_API_KEY tests the AI without PayPal.
EID_PAYPAL=
EID_AI=
# Where job JSON files and the audit log (eid.log.jsonl) are written.
EID_DATA_DIR=./data
# Public URL of `python -m eid serve`. Used for the customer link and the PayPal
# return/cancel URLs. Keep the default when running locally.
EID_BASE_URL=http://localhost:8000
