# PayPal: "sandbox" talks to api-m.sandbox.paypal.com, "mock" is an offline simulator.
# Default: sandbox if PAYPAL_CLIENT_ID is set, otherwise mock.
EID_PAYPAL=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI: "claude" calls the Claude API, "mock" uses deterministic offline heuristics.
# Default: claude if ANTHROPIC_API_KEY is set, otherwise mock.
EID_AI=claude
ANTHROPIC_API_KEY=
EID_MODEL=claude-opus-5-5

# Where job state and logs live, and the public URL of `python -m eid serve`.
EID_DATA_DIR=./data
EID_BASE_URL=http://localhost:8000
